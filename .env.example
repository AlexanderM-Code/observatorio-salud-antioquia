# Copia este archivo como .env y cambia los valores. El archivo .env no se sube a GitHub.
MYSQL_USER=observatorio
MYSQL_PASSWORD=cambia-esta-clave
MYSQL_ROOT_PASSWORD=cambia-esta-clave-tambien

# Para ejecutar el pipeline fuera de Docker:
MYSQL_URL=mysql+pymysql://observatorio:cambia-esta-clave@localhost:3306/observatorio_salud

# Opcional: token gratuito de datos.gov.co para más solicitudes por hora.
SOCRATA_APP_TOKEN=
